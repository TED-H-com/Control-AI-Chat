    "@types/node": "^22.18.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "1.54.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
