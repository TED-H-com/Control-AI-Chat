# Copy to .env and fill in. Keep it chmod 600; it holds the keys that protect the audit chain
# and every stored provider credential.
#
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Where this deployment lives
# ---------------------------------------------------------------------------

# The domain users type. DNS must already point at this host; the proxy obtains a certificate
# on the first request.
APP_DOMAIN=chat.example.com

# The full origin, scheme included. This is the CSRF Origin allowlist, so it must match exactly
# what the browser sends. Get it wrong and reads keep working while every save returns
# 403 CSRF_REJECTED — which looks like a broken application rather than a typo.
APP_ORIGIN=https://chat.example.com

# Production enables secure cookies and strict startup validation.
NODE_ENV=production

# Required address for certificate notices. Caddy refuses an empty `email` directive.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Secrets — generate these, never invent them by hand
# ---------------------------------------------------------------------------
#   openssl rand -hex 48   # JWT_SECRET
#   openssl rand -hex 32   # AUDIT_KEY, provider credential key, PROXY_SHARED_SECRET

# Signs session tokens. Must be at least 32 bytes. Rotating it signs everyone out and costs
# nothing else.
JWT_SECRET=

# Authenticates Caddy's source-IP assertion to the app across the private Docker network. Caddy
# overwrites both internal headers, and the app ignores a forwarded address without this secret.
PROXY_SHARED_SECRET=

# The root of the audit chain and protected audit data. Rotating it is DESTRUCTIVE: chain
# verification stops working and encrypted audit transcripts become unreadable. Generate it once,
# back it up with the database, and leave it alone.
AUDIT_KEY=

# The root for sealed provider credentials, deliberately separate from AUDIT_KEY so that
# rotating a leaked provider key does not destroy the audit chain.
PROVIDER_CREDENTIAL_KEY=

# Rotating that root: generate a new key, move the old value into
# PROVIDER_CREDENTIAL_PREVIOUS_KEYS under the version it was used at, raise the version, then run
#   docker compose exec app npm run rotate-provider-credentials
# Every stored credential is re-sealed under the new version. A workspace whose old key is missing
# fails loudly and keeps its existing ciphertext, so a half-finished rotation cannot leave a
# workspace unable to reach its providers. Once every credential reports the new version you may
# drop the old key from the map.
PROVIDER_CREDENTIAL_KEY_VERSION=1
PROVIDER_CREDENTIAL_PREVIOUS_KEYS=

# Fresh deployments should enforce the retention window configured per workspace. On an upgrade,
# this variable is intentionally absent and enforcement stays off until you review the existing
# backlog and take a backup; see docs/DEPLOY.md before setting it to true.
RETENTION_ENFORCEMENT_ENABLED=true

# ---------------------------------------------------------------------------
# Notice there are no provider API keys here
# ---------------------------------------------------------------------------
# The application never reads a model credential from the environment. An administrator supplies
# each provider's key in the console, where it is sealed at rest and bound to this workspace
# and that provider. That is the point of this setup: the keys are yours, they are not in a
# config file, and we never see them.

# ---------------------------------------------------------------------------
# Optional — outbound email, for invitations and password resets
# ---------------------------------------------------------------------------
# Leave every one of these blank to disable mail. If you set any of them, SMTP_HOST and
# SMTP_FROM become required and the server refuses to start without them; the same is true of
# SMTP_USER and SMTP_PASS as a pair.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
