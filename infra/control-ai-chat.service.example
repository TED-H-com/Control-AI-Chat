[Unit]
Description=Control AI Chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
Group=<service-group>
UMask=0077
WorkingDirectory=<repository-path>/server
EnvironmentFile=<repository-path>/.env
Environment=DB_PATH=<data-path>/app.db
Environment=UPLOAD_DIR=<data-path>/uploads
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<data-path>
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
